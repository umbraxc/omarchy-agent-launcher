{
  "schemaVersion": 1,
  "id": "io.github.umbraxc.agent-launcher",
  "name": "Omarchy Umbra Agent Tool",
  "version": "2.0.0",
  "author": "umbraxc",
  "license": "MIT",
  "description": "Local and online AI agents in one bar icon: on-device AI apps and models, plus your coding agents, each opened with one click",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Umbra Agent Tool",
    "description": "LOCAL: on-device AI apps and Ollama models (or a guided setup). ONLINE AGENTS: coding agents with live session counts.",
    "category": "AI",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalMs": 5000,
      "showOllamaModels": true,
      "localApps": []
    },
    "schema": [
      {
        "key": "pollIntervalMs",
        "type": "integer",
        "label": "Status refresh (ms)",
        "min": 1000,
        "max": 60000,
        "step": 1000,
        "defaultValue": 5000
      },
      {
        "key": "showOllamaModels",
        "type": "boolean",
        "label": "List Ollama models under LOCAL",
        "defaultValue": true
      }
    ]
  }
}
