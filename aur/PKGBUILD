# Maintainer: umbraxc <334050264+umbraxc@users.noreply.github.com>
pkgname=umbra-wiki
pkgver=3.2.4
pkgrel=1
_commit=e4c298c8d8aade706ed0680a9153ce7524d5f91d   # exact 3.2.4 release source
pkgdesc="Offline survival assistant: a local AI that answers from an offline library, with sources"
arch=('any')
url="https://github.com/umbraxc/omarchy-umbra"
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'python-cryptography' 'gtk3' 'glib2' 'webkit2gtk-4.1' 'ollama' 'kiwix-tools' 'jq' 'curl' 'pciutils' 'hwdata'
         'xdg-utils' 'xdg-user-dirs' 'libnotify' 'hicolor-icon-theme' 'ttf-jetbrains-mono-nerd')
optdepends=('pipewire-audio: sounds and voice recording'
            'libpulse: sounds on systems that use PulseAudio'
            'voxtype-bin: offline voice input (AUR)'
            'ollama-cuda: run the AI on an NVIDIA graphics card'
            'ollama-rocm: run the AI on an AMD graphics card'
            'ollama-vulkan: run the AI on most graphics cards (Vulkan)'
            'networkmanager: Wi-Fi networks on the Signals screen, and joining them (iwd works too)'
            'bluez-utils: Bluetooth devices on the Signals screen'
            'poppler: read text from linked PDF files')
install=umbra-wiki.install
source=("$pkgname-$pkgver-$pkgrel.tar.gz::https://github.com/umbraxc/omarchy-umbra/releases/download/v$pkgver/umbra-wiki-$pkgver-source.tar.gz")
sha256sums=('e30fa437d9d87ec71a3919b53e661d5714ac63b8d8986a841f5b667923657b50')

package() {
  cd "omarchy-umbra-$_commit/umbra-wiki"
  local app="$pkgdir/usr/share/umbra-wiki"

  install -d "$app"
  cp -r ui sounds "$app/"
  install -m644 server.py maps.py pmtiles.py radar.py transfers.py linked_library.py outpost.py outpost_data.py camp.py sky.py speech.py speech_worker.py lora.py lora_worker.py listen.py listen_worker.py manuals.json facts.json fieldmanual.json knowledge.json library.json packs.json achievements.json farming.json "$app/"
  install -Dm644 maps/world.mbtiles maps/countries.json maps/atlas.json maps/atlas-more.json -t "$app/maps/"
  install -m755 fetch-archive.sh uninstall.sh "$app/"

  install -Dm755 umbra-wiki "$pkgdir/usr/bin/umbra-wiki"
  install -Dm644 packaging/umbra-wiki.service "$pkgdir/usr/lib/systemd/user/umbra-wiki.service"
  install -Dm644 packaging/org.umbra.wiki.desktop "$pkgdir/usr/share/applications/org.umbra.wiki.desktop"
  install -Dm644 ui/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.umbra.wiki.svg"

  cd ..
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md CREDITS.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
