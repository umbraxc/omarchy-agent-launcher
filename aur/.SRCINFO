pkgbase = umbra-wiki
	pkgdesc = Offline survival assistant: a local AI that answers from an offline library, with sources
	pkgver = 3.2.2
	pkgrel = 1
	url = https://github.com/umbraxc/omarchy-umbra
	install = umbra-wiki.install
	arch = any
	license = MIT
	depends = python
	depends = python-gobject
	depends = python-cairo
	depends = python-cryptography
	depends = gtk3
	depends = glib2
	depends = webkit2gtk-4.1
	depends = ollama
	depends = kiwix-tools
	depends = jq
	depends = curl
	depends = pciutils
	depends = hwdata
	depends = xdg-utils
	depends = xdg-user-dirs
	depends = libnotify
	depends = hicolor-icon-theme
	depends = ttf-jetbrains-mono-nerd
	optdepends = pipewire-audio: sounds and voice recording
	optdepends = libpulse: sounds on systems that use PulseAudio
	optdepends = voxtype-bin: offline voice input (AUR)
	optdepends = ollama-cuda: run the AI on an NVIDIA graphics card
	optdepends = ollama-rocm: run the AI on an AMD graphics card
	optdepends = ollama-vulkan: run the AI on most graphics cards (Vulkan)
	optdepends = networkmanager: Wi-Fi networks on the Signals screen, and joining them (iwd works too)
	optdepends = bluez-utils: Bluetooth devices on the Signals screen
	optdepends = poppler: read text from linked PDF files
